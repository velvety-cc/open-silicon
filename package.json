{
  "name": "opensilicon",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace=@opensilicon/web --",
    "dev:deck": "npm run dev --workspace=@opensilicon/deck --",
    "assets:sync": "node tooling/sync-assets.mjs",
    "build": "npm run check:architecture && npm run build:web && npm run build:deck && npm run build:other-materials && npm run build:risks",
    "build:web": "npm run build --workspace=@opensilicon/web",
    "build:deck": "npm run build --workspace=@opensilicon/deck",
    "start:web": "npm run start --workspace=@opensilicon/web --",
    "start:deck": "npm run start --workspace=@opensilicon/deck --",
    "lint": "npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:architecture": "node tooling/check-architecture.mjs",
    "test": "npm run check:architecture && node --test tooling/tests/*.test.mjs && npm run test --workspaces --if-present",
    "export:deck": "node tooling/export-deck.mjs",
    "dev:other-materials": "npm run dev --workspace=@opensilicon/other-materials --",
    "build:other-materials": "npm run build --workspace=@opensilicon/other-materials --",
    "export:other-materials": "npm run export --workspace=@opensilicon/other-materials --",
    "dev:risks": "npm run dev --workspace=@opensilicon/risks --",
    "build:risks": "npm run build --workspace=@opensilicon/risks --",
    "verify:risks": "npm run verify --workspace=@opensilicon/risks --",
    "examples:risks": "npm run examples --workspace=@opensilicon/risks --",
    "audit:risks": "npm run audit --workspace=@opensilicon/risks --"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2"
  }
}
